# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Environments
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# FaceForensics++ & Video Datasets (Root directories only)
/data/
/datasets/
/raw_data/
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z

# Explicitly track small social media test videos in video_storage/
!video_storage/
!video_storage/**

# Model weights & Checkpoints (Never commit weights)
/checkpoints/
/weights/
/models/
*.pth
*.pt
*.onnx
*.h5
*.safetensors
*.bin
*.engine
*.trt
*.pkl

# Extracted data, embeddings, predictions & logs
/frames/
/crops/
/embeddings/
/predictions/
/logs/
/outputs/
/cache/
/scratch/
/runs/

# Explicitly ensure pipeline data module is tracked
!src/pipeline/data/
!src/pipeline/data/**
src/pipeline/data/**/__pycache__/
src/pipeline/data/**/*.py[cod]

# Result figures and generated artifacts (keep .gitkeep in results/)
results/*
!results/.gitkeep

# IDE & OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
